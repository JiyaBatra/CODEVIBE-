# Server port (default: 5002)
PORT=5002

# MongoDB connection string
DB_URL=mongodb://127.0.0.1:27017/codevibe

# Frontend URL used in password-reset emails (must match your deployed or local client)
CLIENT_URL=http://localhost:5173

# Gmail / SMTP credentials for Nodemailer (use an App Password for Gmail)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
