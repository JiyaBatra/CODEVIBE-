# CodeVibe Server Configuration Environment Variables

# Express Port
PORT=5002

# MongoDB Connection String (Fallback to local in dev)
# For local development, use: mongodb://127.0.0.1:27017/codevibe
DB_URL=mongodb://127.0.0.1:27017/codevibe

# Nodemailer SMTP Configuration
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password