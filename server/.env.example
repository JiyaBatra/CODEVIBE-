# Server Port (Default: 5002)
PORT=5002

# MongoDB Connection String
DB_URL=mongodb://127.0.0.1:27017/codevibe
# Alternatively use MONGODB_URI
# MONGODB_URI=

# JWT Secret Key (Required for authentication)
# Generate a secure key by running: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_here

# CORS Allowed Origins (Comma separated URLs)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# GitHub Leaderboard Sync (Optional)
LEADERBOARD_API_URL=
LEADERBOARD_API_TOKEN=

# Nodemailer Email Service Settings (Required for forgot password feature)
# 1. Enable 2-Step Verification in your Google Account Settings (https://myaccount.google.com)
# 2. Go to Security -> 2-Step Verification -> App Passwords (at the bottom of the page)
# 3. Enter an App name (e.g., "CodeVibe") and click Create
# 4. Copy the generated 16-character code (you can paste it with or without spaces)
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-16-character-app-password
